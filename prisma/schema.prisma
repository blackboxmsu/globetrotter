generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String              @id @default(cuid())
  firstName             String
  lastName              String
  email                 String              @unique
  password              String
  phone                 String?
  city                  String?
  country               String?
  additionalInformation String?
  profileImage          String?
  language              String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  trips                 Trip[]
  savedDestinations     SavedDestination[]
  communityPosts        CommunityPost[]
}

model Trip {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  budget         Float?
  coverImage     String?
  status         String          @default("PLANNED") // e.g., PLANNED, ONGOING, COMPLETED
  isPublic       Boolean         @default(false)
  shareId        String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripStops      TripStop[]
  expenses       Expense[]
  communityPosts CommunityPost[]

  @@index([userId])
  @@index([startDate])
  @@index([status])
  @@index([shareId])
}

model City {
  id                String             @id @default(cuid())
  name              String
  country           String
  region            String?
  description       String?
  latitude          Float?
  longitude         Float?
  costIndex         Int?
  popularity        Int?
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tripStops         TripStop[]
  activities        Activity[]
  savedDestinations SavedDestination[]

  @@index([name])
  @@index([country])
  @@index([region])
  @@index([popularity])
}

model TripStop {
  id             String         @id @default(cuid())
  tripId         String
  cityId         String
  order          Int
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  trip           Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city           City           @relation(fields: [cityId], references: [id], onDelete: Restrict)
  stopActivities StopActivity[]

  @@index([tripId])
  @@index([cityId])
  @@index([order])
}

model Activity {
  id             String         @id @default(cuid())
  cityId         String
  name           String
  description    String?
  category       String
  duration       Int?           // in minutes
  estimatedCost  Float?
  rating         Float?
  popularity     Int?
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stopActivities StopActivity[]

  @@index([cityId])
  @@index([category])
  @@index([estimatedCost])
}

model StopActivity {
  id             String    @id @default(cuid())
  tripStopId     String
  activityId     String
  date           DateTime?
  startTime      String?   // e.g. "09:00"
  endTime        String?
  order          Int
  customCost     Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tripStop       TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity       Activity  @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([tripStopId])
  @@index([activityId])
  @@index([date])
  @@index([order])
}

model Expense {
  id          String   @id @default(cuid())
  tripId      String
  category    String   // TRANSPORTATION, ACCOMMODATION, ACTIVITIES, MEALS, MISCELLANEOUS
  amount      Float
  description String?
  date        DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model SavedDestination {
  id        String   @id @default(cuid())
  userId    String
  cityId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([userId, cityId])
}

model CommunityPost {
  id          String    @id @default(cuid())
  tripId      String
  userId      String
  title       String
  description String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trip        Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
}
